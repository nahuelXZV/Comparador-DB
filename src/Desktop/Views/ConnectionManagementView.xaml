<UserControl x:Class="Desktop.Views.ConnectionManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Desktop.Behaviors">
    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="6" Padding="12" Margin="0,12,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel.Resources>
                    <Style x:Key="SavedConnectionListButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Height" Value="28" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,3,0,0" />
                        <Setter Property="Background" Value="#0F5FDC" />
                        <Setter Property="BorderBrush" Value="#0B4DB8" />
                        <Setter Property="Foreground" Value="White" />
                    </Style>
                </StackPanel.Resources>

                <TextBlock Text="CONEXIONES GUARDADAS" Style="{StaticResource SectionHeader}" TextWrapping="Wrap" />
                <ListBox ItemsSource="{Binding SavedConnections}"
                         SelectedItem="{Binding SelectedConnection, Mode=TwoWay}"
                         DisplayMemberPath="Name" MinHeight="320" BorderBrush="{StaticResource BorderBrush}" />
                <Button Content="Nueva conexión" Command="{Binding NewCommand}"
                        Style="{StaticResource SavedConnectionListButton}" Margin="0,12,0,0" />
                <Button Content="Actualizar lista" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SavedConnectionListButton}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="DETALLE DE CONEXIÓN" Style="{StaticResource SectionHeader}" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="95" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Nombre" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Style="{StaticResource FormTextBox}"
                             Text="{Binding ConnectionName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Text="Servidor" VerticalAlignment="Center" Margin="0,9,0,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormTextBox}"
                             Text="{Binding Editor.Server, UpdateSourceTrigger=PropertyChanged}" Margin="0,9,0,0" />
                    <TextBlock Grid.Row="2" Text="Usuario" VerticalAlignment="Center" Margin="0,9,0,0" />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FormTextBox}"
                             Text="{Binding Editor.UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,9,0,0" />
                    <TextBlock Grid.Row="3" Text="Contraseña" VerticalAlignment="Center" Margin="0,9,0,0" />
                    <PasswordBox Grid.Row="3" Grid.Column="1" Margin="0,9,0,0"
                                 behaviors:PasswordBoxBehavior.Password="{Binding Editor.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <WrapPanel Margin="0,12,0,0">
                    <Button Content="Probar conexión" Command="{Binding TestCommand}" />
                    <Button Content="Guardar" Command="{Binding SaveCommand}" />
                    <Button Content="Eliminar" Command="{Binding DeleteCommand}" Background="#B42318" BorderBrush="#8D1C13" />
                </WrapPanel>
                <TextBlock Text="{Binding Status}" Foreground="#52647E" Margin="3,9,3,0" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
