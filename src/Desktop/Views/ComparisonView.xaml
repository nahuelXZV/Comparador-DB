<UserControl x:Class="Desktop.Views.ComparisonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Application.Models;assembly=Application"
             xmlns:views="clr-namespace:Desktop.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="1. CONEXIONES" Style="{StaticResource SectionHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <views:ConnectionFormView DataContext="{Binding Origin}" />
                            <views:ConnectionFormView Grid.Column="2" DataContext="{Binding Destination}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="2. CONFIGURACIÓN" Style="{StaticResource SectionHeader}" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Método de generación" VerticalAlignment="Center" Margin="0,0,9,0" />
                            <ComboBox Grid.Column="1" Width="150" HorizontalAlignment="Left"
                                      SelectedValuePath="Tag" SelectedValue="{Binding SelectedGenerationMode}">
                                <ComboBoxItem Content="Actualización segura" Tag="{x:Static models:ScriptGenerationMode.SafeUpdate}" />
                                <ComboBoxItem Content="Reconstruir tabla" Tag="{x:Static models:ScriptGenerationMode.RebuildTable}" />
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="Esquema origen" VerticalAlignment="Center" Margin="0,8,9,0" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Width="150" HorizontalAlignment="Left" IsEditable="True"
                                      ItemsSource="{Binding Origin.Form.Schemas}"
                                      Text="{Binding Origin.Form.Schema, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="Esquema destino" VerticalAlignment="Center" Margin="0,8,9,0" />
                            <ComboBox Grid.Row="1" Grid.Column="4" Width="130" HorizontalAlignment="Left" IsEditable="True"
                                      ItemsSource="{Binding Destination.Form.Schemas}"
                                      Text="{Binding Destination.Form.Schema, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />

                            <Button Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Content="Comparar" Command="{Binding CompareCommand}" />
                        </Grid>

                        <WrapPanel Margin="0,12,0,0">
                            <CheckBox Content="Tablas faltantes" IsChecked="{Binding CompareMissingTables}" Margin="0,0,16,0" />
                            <CheckBox Content="Columnas faltantes" IsChecked="{Binding CompareMissingColumns}" Margin="0,0,16,0" />
                            <CheckBox Content="Omitir tablas por nombre" IsChecked="{Binding IsTableNameFilterEnabled}" />
                        </WrapPanel>

                        <CheckBox Content="Omitir tablas con columnas solo en destino"
                                  IsChecked="{Binding SkipTablesWithDestinationOnlyColumns}"
                                  ToolTip="Al desmarcarlo, esas columnas se eliminarán al reconstruir la tabla."
                                  Margin="0,10,0,0">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedGenerationMode}" Value="{x:Static models:ScriptGenerationMode.RebuildTable}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>

                        <Grid Margin="0,10,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTableNameFilterEnabled}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Coincidencia" VerticalAlignment="Center" Margin="0,0,9,0" />
                            <ComboBox Grid.Column="1" Width="170" HorizontalAlignment="Left"
                                      SelectedValuePath="Tag" SelectedValue="{Binding SelectedTableNameFilterMode}">
                                <ComboBoxItem Content="Empieza con" Tag="{x:Static models:TableNameFilterMode.StartsWith}" />
                                <ComboBoxItem Content="Termina con" Tag="{x:Static models:TableNameFilterMode.EndsWith}" />
                                <ComboBoxItem Content="Contiene" Tag="{x:Static models:TableNameFilterMode.Contains}" />
                            </ComboBox>
                            <TextBlock Grid.Column="3" Text="Patrones" VerticalAlignment="Center" Margin="0,0,9,0" />
                            <TextBox Grid.Column="4" Width="160" HorizontalAlignment="Left" Style="{StaticResource FormTextBox}"
                                     Text="{Binding ExcludedTablePatterns, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Separe los patrones con comas. Ejemplo: rh, pl" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="3. SCRIPT SQL" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding ComparisonSummary}" Foreground="#52647E" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <TextBox Text="{Binding GeneratedScript, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                 AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" Height="240" IsReadOnly="True"
                                 Background="#101827" Foreground="#E8EEF9" Padding="10" />
                        <TextBlock Text="Avisos de seguridad" FontWeight="SemiBold" Margin="0,12,0,5" />
                        <ListBox ItemsSource="{Binding Warnings}" MinHeight="45" BorderBrush="{StaticResource BorderBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Text="{Binding CopyFeedback}" Foreground="#16803A" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="8,0,4,0" />
            <Button Content="Limpiar" Command="{Binding ClearCommand}" />
            <Button Content="Copiar" Command="{Binding CopyCommand}" />
            <Button Content="Guardar .sql" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
