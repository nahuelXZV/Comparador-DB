<UserControl x:Class="Desktop.Views.ConnectionFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Desktop.Behaviors">
    <GroupBox Header="{Binding Title}" Padding="12" BorderBrush="{StaticResource BorderBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="82" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Conexión" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ComboBox Grid.Column="1"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      TextSearch.TextPath="Name"
                      ItemsSource="{Binding SavedConnections}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedSavedConnection, Mode=TwoWay}"
                      ToolTip="Escriba o seleccione una conexión guardada" />

            <TextBlock Grid.Row="1" Text="Servidor" VerticalAlignment="Center" Margin="0,9,0,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormTextBox}"
                     Text="{Binding Form.Server, UpdateSourceTrigger=PropertyChanged}" Margin="0,9,0,0" />

            <TextBlock Grid.Row="2" Text="Usuario" VerticalAlignment="Center" Margin="0,9,0,0" />
            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FormTextBox}"
                     Text="{Binding Form.UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,9,0,0" />

            <TextBlock Grid.Row="3" Text="Contraseña" VerticalAlignment="Center" Margin="0,9,0,0" />
            <PasswordBox Grid.Row="3" Grid.Column="1" Margin="0,9,0,0"
                         behaviors:PasswordBoxBehavior.Password="{Binding Form.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="4" Text="Base de datos" VerticalAlignment="Center" Margin="0,9,0,0" />
            <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,9,0,0"
                      IsEditable="True"
                      ItemsSource="{Binding Form.Databases}"
                      Text="{Binding Form.DatabaseName, UpdateSourceTrigger=PropertyChanged}"
                      behaviors:ComboBoxSelectionBehavior.Command="{Binding LoadSchemasCommand}" />

            <Button Grid.Row="5" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="0,12,0,0"
                    Content="Probar conexión" Command="{Binding LoadDatabasesCommand}" />

            <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Margin="3,8,3,0"
                       Text="{Binding Form.Status}" Foreground="#52647E" TextWrapping="Wrap" />
        </Grid>
    </GroupBox>
</UserControl>
