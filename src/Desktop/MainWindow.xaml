<Window x:Class="Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Application.Models;assembly=Application"
        Title="Comparador de Bases de Datos"
        Width="700"
        Height="840"
        MinWidth="620"
        MinHeight="700"
        Icon="Assets/comparador-logo.png"
        Background="#F5F7FB">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0F5FDC" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D9E1EE" />
        <Style TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#0B4DB8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1061DD" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#0C55BE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#0B4DB8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#84ABE2" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThinScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThinScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder" Margin="0.5" Background="#AAB3C2" CornerRadius="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#929EAF" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#7D899A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="4" />
            <Setter Property="Background" Value="#E5EBF4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <Grid>
                                <Track x:Name="VerticalTrack" Orientation="Vertical" IsDirectionReversed="True"
                                       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                       ViewportSize="{TemplateBinding ViewportSize}"
                                       Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ThinScrollPageButton}" Command="{x:Static ScrollBar.PageUpCommand}"
                                                      CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ThinScrollThumb}" MinHeight="28" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ThinScrollPageButton}" Command="{x:Static ScrollBar.PageDownCommand}"
                                                      CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                                <Track x:Name="HorizontalTrack" Orientation="Horizontal" Visibility="Collapsed"
                                       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                       ViewportSize="{TemplateBinding ViewportSize}"
                                       Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ThinScrollPageButton}" Command="{x:Static ScrollBar.PageLeftCommand}"
                                                      CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ThinScrollThumb}" MinWidth="28" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ThinScrollPageButton}" Command="{x:Static ScrollBar.PageRightCommand}"
                                                      CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="VerticalTrack" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="HorizontalTrack" Property="Visibility" Value="Visible" />
                                <Setter Property="Height" Value="4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#123D7A" />
            <Setter Property="Margin" Value="0,0,0,9" />
        </Style>
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="MaxWidth" Value="270" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="MaxWidth" Value="270" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="MaxWidth" Value="270" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="18">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="IsEnabled" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsComparing}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
            <Image Source="Assets/comparador-logo.png" Width="46" Height="46" Stretch="Uniform" Margin="0,0,12,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Comparador de Bases de Datos" FontSize="24" FontWeight="SemiBold" Foreground="#102A56" />
            </StackPanel>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Comparar">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="1. CONEXIONES" Style="{StaticResource SectionHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <GroupBox Header="Base origen" Padding="12" BorderBrush="{StaticResource BorderBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" ><Run Text="Conexi"/><Run Language="es-bo" Text="o"/><Run Text="n"/><Run Text="es"/></TextBlock>
                                                    <ComboBox Grid.Column="1" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                                      ItemsSource="{Binding SavedConnections}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedOriginSavedConnection, Mode=TwoWay}"
                                      ToolTip="Escriba o seleccione una conexión guardada" />
                            <TextBlock Grid.Row="1" Text="Servidor" VerticalAlignment="Center" Margin="0,9,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormTextBox}" Text="{Binding Origin.Server, UpdateSourceTrigger=PropertyChanged}" Margin="0,9,0,0" />
                            <TextBlock Grid.Row="2" Text="Usuario" VerticalAlignment="Center" Margin="0,9,0,0" />
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FormTextBox}" Text="{Binding Origin.UserName}" Margin="0,9,0,0" />
                            <TextBlock Grid.Row="3" Text="Contraseña" VerticalAlignment="Center" Margin="0,9,0,0" />
                            <PasswordBox x:Name="OriginPasswordBox" Grid.Row="3" Grid.Column="1" PasswordChanged="OriginPasswordChanged" Margin="0,9,0,0" />
                            <TextBlock Grid.Row="4" Text="Base de datos" VerticalAlignment="Center" Margin="0,9,0,0" />
                            <ComboBox Grid.Row="4" Grid.Column="1" IsEditable="True" ItemsSource="{Binding Origin.Databases}" SelectionChanged="OriginDatabaseSelectionChanged"
                                      Text="{Binding Origin.DatabaseName, UpdateSourceTrigger=PropertyChanged}" Margin="0,9,0,0" />
                            <Button Grid.Row="5" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="0,12,0,0" Content="Probar conexión" Command="{Binding LoadOriginDatabasesCommand}" />
                                                </Grid>
                            </GroupBox>

                            <GroupBox Grid.Column="2" Header="Base destino" Padding="12" BorderBrush="{StaticResource BorderBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" ><Run Text="Conexi"/><Run Language="es-bo" Text="o"/><Run Text="n"/><Run Language="es-bo" Text="es"/></TextBlock>
                                                    <ComboBox Grid.Column="1" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                                      ItemsSource="{Binding SavedConnections}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedDestinationSavedConnection, Mode=TwoWay}"
                                      ToolTip="Escriba o seleccione una conexión guardada" />
                            <TextBlock Grid.Row="1" Text="Servidor" VerticalAlignment="Center" Margin="0,9,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormTextBox}" Text="{Binding Destination.Server, UpdateSourceTrigger=PropertyChanged}" Margin="0,9,0,0" />
                            <TextBlock Grid.Row="2" Text="Usuario" VerticalAlignment="Center" Margin="0,9,0,0" />
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FormTextBox}" Text="{Binding Destination.UserName}" Margin="0,9,0,0" />
                            <TextBlock Grid.Row="3" Text="Contraseña" VerticalAlignment="Center" Margin="0,9,0,0" />
                            <PasswordBox x:Name="DestinationPasswordBox" Grid.Row="3" Grid.Column="1" PasswordChanged="DestinationPasswordChanged" Margin="0,9,0,0" />
                            <TextBlock Grid.Row="4" Text="Base de datos" VerticalAlignment="Center" Margin="0,9,0,0" />
                            <ComboBox Grid.Row="4" Grid.Column="1" IsEditable="True" ItemsSource="{Binding Destination.Databases}" SelectionChanged="DestinationDatabaseSelectionChanged"
                                      Text="{Binding Destination.DatabaseName, UpdateSourceTrigger=PropertyChanged}" Margin="0,9,0,0" />
                            <Button Grid.Row="5" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="0,12,0,0" Content="Probar conexión" Command="{Binding LoadDestinationDatabasesCommand}" />
                                                </Grid>
                            </GroupBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" ><Run Text="2. "/><Run Language="es-bo" Text="CONFIGURACIÓN"/></TextBlock>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Método de generación" VerticalAlignment="Center" Margin="0,0,9,0" />
                            <ComboBox Grid.Column="1" Width="150" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding SelectedGenerationMode}">
                                <ComboBoxItem Content="Actualización segura" Tag="{x:Static models:ScriptGenerationMode.SafeUpdate}" />
                                <ComboBoxItem Content="Reconstruir tabla" Tag="{x:Static models:ScriptGenerationMode.RebuildTable}" />
                            </ComboBox>
                            <TextBlock Grid.Row="1" Text="Esquema origen" VerticalAlignment="Center" Margin="0,8,9,0" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Width="150" HorizontalAlignment="Left" IsEditable="True" ItemsSource="{Binding Origin.Schemas}" Text="{Binding OriginSchema, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="Esquema destino" VerticalAlignment="Center" Margin="0,8,9,0" />
                            <ComboBox Grid.Row="1" Grid.Column="4" Width="130" HorizontalAlignment="Left" IsEditable="True" ItemsSource="{Binding Destination.Schemas}" Text="{Binding DestinationSchema, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                            <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="0,10,0,0" Content="Comparar" Command="{Binding CompareCommand}" />
                        </Grid>
                        <WrapPanel Margin="0,12,0,0">
                            <CheckBox Content="Tablas faltantes" IsChecked="{Binding CompareMissingTables}" Margin="0,0,16,0" />
                            <CheckBox Content="Columnas faltantes" IsChecked="{Binding CompareMissingColumns}" Margin="0,0,16,0" />
                            <CheckBox Content="Omitir tablas por nombre" IsChecked="{Binding IsTableNameFilterEnabled}" />
                        </WrapPanel>
                        <CheckBox Content="Omitir tablas con columnas solo en destino"
                                  IsChecked="{Binding SkipTablesWithDestinationOnlyColumns}"
                                  ToolTip="Al desmarcarlo, esas columnas se eliminarán al reconstruir la tabla."
                                  Margin="0,10,0,0">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedGenerationMode}" Value="{x:Static models:ScriptGenerationMode.RebuildTable}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                        <Grid Margin="0,10,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTableNameFilterEnabled}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Coincidencia" VerticalAlignment="Center" Margin="0,0,9,0" />
                            <ComboBox Grid.Column="1" Width="170" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding SelectedTableNameFilterMode}">
                                <ComboBoxItem Content="Empieza con" Tag="{x:Static models:TableNameFilterMode.StartsWith}" />
                                <ComboBoxItem Content="Termina con" Tag="{x:Static models:TableNameFilterMode.EndsWith}" />
                                <ComboBoxItem Content="Contiene" Tag="{x:Static models:TableNameFilterMode.Contains}" />
                            </ComboBox>
                            <TextBlock Grid.Column="3" Text="Patrones" VerticalAlignment="Center" Margin="0,0,9,0" />
                            <TextBox Grid.Column="4" Width="160" HorizontalAlignment="Left" Style="{StaticResource FormTextBox}" Text="{Binding ExcludedTablePatterns, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Separe los patrones con comas. Ejemplo: rh, pl" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="3. SCRIPT SQL" Style="{StaticResource SectionHeader}" />
                        <TextBox Text="{Binding GeneratedScript, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="13" AcceptsReturn="True"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 MinHeight="220" IsReadOnly="True" Background="#101827" Foreground="#E8EEF9" Padding="10" />
                        <TextBlock Text="Avisos de seguridad" FontWeight="SemiBold" Margin="0,12,0,5" />
                        <ListBox ItemsSource="{Binding Warnings}" MinHeight="45" BorderBrush="{StaticResource BorderBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <TextBlock Text="{Binding CopyFeedback}" Foreground="#16803A" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,4,0" />
                        <Button Content="Limpiar" Command="{Binding ClearCommand}" Click="ClearPasswords" />
                        <Button Content="Copiar" Command="{Binding CopyCommand}" />
                        <Button Content="Guardar .sql" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Gestionar conexiones">
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel.Resources>
                                <Style x:Key="SavedConnectionListButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Height" Value="28" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="Margin" Value="0,3,0,0" />
                                    <Setter Property="Background" Value="#0F5FDC" />
                                    <Setter Property="BorderBrush" Value="#0B4DB8" />
                                    <Setter Property="Foreground" Value="White" />
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock Text="CONEXIONES GUARDADAS" Style="{StaticResource SectionHeader}" />
                            <ListBox ItemsSource="{Binding SavedConnections}" SelectedItem="{Binding SelectedSavedConnection, Mode=TwoWay}"
                                     DisplayMemberPath="Name" MinHeight="320" BorderBrush="{StaticResource BorderBrush}" />
                            <Button Content="Nueva conexión" Command="{Binding NewManagedConnectionCommand}" Style="{StaticResource SavedConnectionListButton}" Margin="0,12,0,0" />
                            <Button Content="Actualizar lista" Command="{Binding RefreshManagedConnectionsCommand}" Style="{StaticResource SavedConnectionListButton}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DETALLE DE CONEXIÓN" Style="{StaticResource SectionHeader}" />
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="95" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Nombre" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Style="{StaticResource FormTextBox}" Text="{Binding ManagedConnectionName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Text="Servidor" VerticalAlignment="Center" Margin="0,9,0,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FormTextBox}" Text="{Binding ManagedConnection.Server, UpdateSourceTrigger=PropertyChanged}" Margin="0,9,0,0" />
                                <TextBlock Grid.Row="2" Text="Usuario" VerticalAlignment="Center" Margin="0,9,0,0" />
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FormTextBox}" Text="{Binding ManagedConnection.UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,9,0,0" />
                                <TextBlock Grid.Row="3" Text="Contraseña" VerticalAlignment="Center" Margin="0,9,0,0" />
                                <PasswordBox x:Name="ManagedPasswordBox" Grid.Row="3" Grid.Column="1" PasswordChanged="ManagedPasswordChanged" Margin="0,9,0,0" />
                            </Grid>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Probar conexión" Command="{Binding TestManagedConnectionCommand}" />
                                <Button Content="Guardar" Command="{Binding SaveManagedConnectionCommand}" />
                                <Button Content="Eliminar" Command="{Binding DeleteManagedConnectionCommand}" Background="#B42318" BorderBrush="#8D1C13" />
                            </WrapPanel>
                            </StackPanel>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
        </Grid>

        <Border Panel.ZIndex="10" Background="#990F1A2E">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsComparing}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Width="300" Padding="28" Background="White" BorderBrush="#D9E1EE" BorderThickness="1" CornerRadius="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Comparando estructuras..." FontSize="18" FontWeight="SemiBold" Foreground="#102A56"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="Espere mientras se leen las bases de datos." Foreground="#52647E" Margin="0,9,0,18"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <ProgressBar Height="8" IsIndeterminate="True" />
                    <Button Content="Cancelar" Command="{Binding CancelComparisonCommand}" Width="100" HorizontalAlignment="Center" Margin="0,22,0,0"
                            Background="#6B7280" BorderBrush="#4B5563" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
