<Window x:Class="Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Desktop.Views"
        Title="Comparador de Bases de Datos"
        Width="700"
        Height="840"
        MinWidth="620"
        MinHeight="700"
        Icon="Assets/comparador-logo.png"
        Background="#F5F7FB">
    <Grid>
        <Grid Margin="18">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="IsEnabled" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Comparison.IsComparing}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                <Image Source="Assets/comparador-logo.png" Width="46" Height="46" Stretch="Uniform" Margin="0,0,12,0" />
                <TextBlock Text="Comparador de Bases de Datos" FontSize="24" FontWeight="SemiBold"
                           Foreground="#102A56" VerticalAlignment="Center" />
            </StackPanel>

            <TabControl Grid.Row="1">
                <TabItem Header="Comparar">
                    <views:ComparisonView DataContext="{Binding Comparison}" />
                </TabItem>
                <TabItem Header="Gestionar conexiones">
                    <views:ConnectionManagementView DataContext="{Binding ConnectionManagement}" />
                </TabItem>
            </TabControl>

            <TextBlock Grid.Row="2" Text="Desarrollado por Nahuel Zalazar" Foreground="#7A879A"
                       FontSize="11" VerticalAlignment="Center" Margin="2,12,0,0" />
        </Grid>

        <Border Panel.ZIndex="10" Background="#990F1A2E">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Comparison.IsComparing}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Width="300" Padding="28" Background="White" BorderBrush="#D9E1EE"
                    BorderThickness="1" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Comparando estructuras..." FontSize="18" FontWeight="SemiBold"
                               Foreground="#102A56" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="Espere mientras se leen las bases de datos." Foreground="#52647E"
                               Margin="0,9,0,18" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <ProgressBar Height="8" IsIndeterminate="True" />
                    <Button Content="Cancelar" Command="{Binding Comparison.CancelComparisonCommand}" Width="100"
                            HorizontalAlignment="Center" Margin="0,22,0,0" Background="#6B7280" BorderBrush="#4B5563" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
